# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---- AWS / S3 ----
# Prefer using `aws configure` (the standard credential chain) over hard-coding keys.
# These are only needed if you are NOT using an AWS profile or IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# Optional: a named profile from ~/.aws/credentials
AWS_PROFILE=

# Where your data lives
S3_BUCKET=my-emteq-bucket
S3_PREFIX=chewing/raw/

# ---- MLflow ----
# Local file store (default) or a remote tracking server URI, e.g. http://127.0.0.1:5000
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=chewing-ssl
